<section class="@Classes" aria-labelledby="@(HasTitle ? headingId : null)">
    <Container>
        @if (HasTitle)
        {
            <header class="@(Centered ? "mx-auto mb-10 max-w-2xl text-center" : "mb-10 max-w-2xl")">
                <h2 id="@headingId" class="font-display text-2xl leading-snug tracking-wide text-text md:text-3xl">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="mt-3 text-text-secondary">@Description</p>
                }
            </header>
        }
        @ChildContent
    </Container>
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Centered { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string headingId = $"section-{Guid.NewGuid():N}";
    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);

    private string Classes =>
        string.Join(' ', new[] { "py-12 md:py-20", Class }.Where(c => !string.IsNullOrWhiteSpace(c)));
}
