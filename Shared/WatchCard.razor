@using System.Globalization
@*
    Listing card (Chrono24-style). The whole card links to the detail page via a
    stretched link; the heart button sits above it (z-10) so it toggles instead
    of navigating. Deliberately NO condition, year or dealer name on the card.
*@

<article class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-surface shadow-soft transition duration-200 hover:-translate-y-0.5 hover:border-gold/30 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
    <!-- Photo -->
    <div class="relative aspect-square w-full overflow-hidden bg-[#131c2b]">
        <img src="@ImageUrl"
             alt="@ImageAlt"
             loading="lazy"
             class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none" />

        @if (Watch.IsPopular)
        {
            <span class="absolute left-3 top-3 rounded-full bg-gold px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-on-gold">
                Popular
            </span>
        }

        <button type="button"
                @onclick="ToggleFavorite"
                aria-label="@(IsFavorite ? "Remove from favorites" : "Add to favorites")"
                aria-pressed="@(IsFavorite ? "true" : "false")"
                class="absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full border border-border bg-header/80 text-text backdrop-blur transition-colors hover:text-gold">
            <svg width="18" height="18" viewBox="0 0 24 24"
                 fill="@(IsFavorite ? "currentColor" : "none")"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="@(IsFavorite ? "text-gold" : "text-text")" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
        </button>
    </div>

    <!-- Text -->
    <div class="flex flex-1 flex-col p-4">
        <h3 class="text-sm font-bold leading-snug text-text">
            <!-- Stretched link: makes the whole card clickable -->
            <a href="/watch/@Watch.Slug" class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:rounded-lg focus-visible:after:ring-2 focus-visible:after:ring-gold">
                @Watch.Brand.Name @Watch.Model
            </a>
        </h3>
        @if (!string.IsNullOrWhiteSpace(Watch.Subtitle))
        {
            <p class="mt-1 line-clamp-1 text-xs text-text-secondary">@Watch.Subtitle</p>
        }

        <div class="mt-auto flex items-end justify-between gap-3 pt-4">
            <div>
                <p class="text-base font-bold text-text">₱@Watch.PricePhp.ToString("N0", CultureInfo.InvariantCulture)</p>
                <p class="text-[11px] text-text-muted">+ ₱@Watch.ShippingCostPhp.ToString("N0", CultureInfo.InvariantCulture) for shipping</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Watch.LocationCountryCode))
            {
                <span class="flex shrink-0 items-center gap-1 text-[11px] text-text-muted" title="Item location">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                    </svg>
                    @Watch.LocationCountryCode
                </span>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Watch Watch { get; set; } = default!;

    /// <summary>In-memory favorite state (not persisted yet), owned by the page.</summary>
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public EventCallback<bool> IsFavoriteChanged { get; set; }

    private string ImageUrl => Watch.Images.Count > 0 ? Watch.Images[0].Url : "/images/landing_page_hero_macro.jpg";
    private string ImageAlt => Watch.Images.Count > 0 && !string.IsNullOrWhiteSpace(Watch.Images[0].AltText)
        ? Watch.Images[0].AltText
        : $"{Watch.Brand.Name} {Watch.Model}";

    private Task ToggleFavorite() => IsFavoriteChanged.InvokeAsync(!IsFavorite);
}
