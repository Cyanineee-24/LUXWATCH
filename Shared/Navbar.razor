<header class="sticky top-0 z-50 border-b border-border bg-header/95 backdrop-blur" role="banner">
    <Container Class="flex h-16 items-center gap-6">

        <a href="/"
           class="shrink-0 font-display text-xl tracking-[0.18em] text-gold transition-colors hover:text-gold-light"
           aria-label="LuxWatch Home">Luxwatch</a>

        <!-- Primary navigation: add links here as routes are added -->
        <nav class="hidden md:block" aria-label="Primary">
            <ul class="flex items-center gap-6">
                <li>
                    <a href="/" class="text-sm text-text-secondary transition-colors hover:text-text">Home</a>
                </li>
            </ul>
        </nav>

        <!-- Search (decorative, unchanged behavior) -->
        <div class="mx-4 hidden max-w-md flex-1 items-center gap-2 rounded-full border border-border bg-white/5 px-5 py-2.5 text-sm text-text-muted lg:flex"
             role="search" aria-label="Search watches">
            <svg class="shrink-0 opacity-60" width="15" height="15" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span>Search through verified outlets worldwide</span>
        </div>

        <!-- AUTH SLOT (Phase 2 replaces the contents of this div) -->
        <div id="navbar-auth-slot" class="ml-auto hidden items-center md:flex">
            <a href="/account/login"
               class="inline-flex items-center gap-2 rounded-md px-2 py-1 text-sm text-text transition-colors hover:text-gold">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                </svg>
                <span>Login or register</span>
            </a>
        </div>

        <!-- Mobile menu toggle -->
        <button type="button"
                class="ml-auto grid size-10 place-items-center rounded-md text-text transition-colors hover:bg-white/5 md:hidden"
                @onclick="ToggleMobileMenu"
                aria-label="Toggle navigation menu"
                aria-controls="mobile-menu"
                aria-expanded="@(mobileMenuCollapsed ? "false" : "true")">
            @if (mobileMenuCollapsed)
            {
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                     stroke-linecap="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            }
            else
            {
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                     stroke-linecap="round" aria-hidden="true">
                    <line x1="5" y1="5" x2="19" y2="19" />
                    <line x1="19" y1="5" x2="5" y2="19" />
                </svg>
            }
        </button>
    </Container>

    @if (!mobileMenuCollapsed)
    {
        <div id="mobile-menu" class="border-t border-border md:hidden" role="navigation" aria-label="Mobile navigation">
            <Container Class="flex flex-col gap-1 py-4">
                <div class="mb-2 flex items-center gap-2 rounded-full border border-border bg-white/5 px-5 py-2.5 text-sm text-text-muted" role="search">
                    <svg class="shrink-0 opacity-60" width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <span>Search through verified outlets worldwide</span>
                </div>

                <a href="/" @onclick="CloseMobileMenu"
                   class="rounded-md px-3 py-3 text-sm text-text-secondary transition-colors hover:bg-white/5 hover:text-text">Home</a>

                <!-- AUTH SLOT (mobile) -->
                <a href="/account/login" @onclick="CloseMobileMenu"
                   class="rounded-md px-3 py-3 text-sm text-text transition-colors hover:bg-white/5 hover:text-gold">Login or register</a>
            </Container>
        </div>
    }
</header>

@code {
    private bool mobileMenuCollapsed = true;

    private void ToggleMobileMenu() => mobileMenuCollapsed = !mobileMenuCollapsed;
    private void CloseMobileMenu() => mobileMenuCollapsed = true;
}
