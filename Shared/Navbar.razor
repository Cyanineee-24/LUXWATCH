<header class="site-header" role="banner">
    <a href="/" class="logo" aria-label="LuxWatch Home">Luxwatch</a>

    <div class="search-bar" role="search" aria-label="Search watches">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span>Search through verified outlets worldwide</span>
    </div>

    @if (NavbarMode == "auth")
    {
        <a class="account-link" href="/account/login">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
            </svg>
            <span>@(UserLabel ?? "Login or register")</span>
        </a>
    }
    else
    {
        <div class="user-badge">
            <div class="user-avatar" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                </svg>
            </div>
            <span>@(UserLabel ?? DefaultUserText)</span>
        </div>
    }

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu"
            aria-label="Toggle navigation menu" aria-expanded="@(!mobileMenuCollapsed)">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</header>

<!-- Mobile dropdown menu -->
@if (!mobileMenuCollapsed)
{
    <div class="mobile-menu" role="navigation" aria-label="Mobile navigation">
        <div class="mobile-menu-inner">
            <div class="mobile-search" role="search">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <span>Search through verified outlets worldwide</span>
            </div>
            @if (NavbarMode == "auth")
            {
                <a class="mobile-account-link" href="/account/login">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                    </svg>
                    @(UserLabel ?? "Login or register")
                </a>
            }
            else
            {
                <div class="mobile-user">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                    </svg>
                    @(UserLabel ?? DefaultUserText)
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>
    /// Display mode for the navbar: "auth" (Login/register link), "guest" (Guest User badge), or "portal" (Collector Portal badge)
    /// </summary>
    [Parameter]
    public string NavbarMode { get; set; } = "guest";

    /// <summary>
    /// Optional label override for the user/auth action text (e.g. username when authenticated).
    /// </summary>
    [Parameter]
    public string? UserLabel { get; set; }

    private bool mobileMenuCollapsed = true;

    private void ToggleMobileMenu() => mobileMenuCollapsed = !mobileMenuCollapsed;

    private string DefaultUserText => NavbarMode switch
    {
        "portal" => "Collector Portal",
        "auth" => "Login or register",
        _ => "Guest User"
    };
}
