@{
    var inputId = Id ?? autoId;
    var errorId = $"{inputId}-error";
    var helpId = $"{inputId}-help";
    var hasError = !string.IsNullOrWhiteSpace(ErrorText);
    var hasHelp = !string.IsNullOrWhiteSpace(HelperText);
    var isPassword = Type == "password";
    string? describedBy = hasError ? errorId : (hasHelp ? helpId : null);
}

<div class="@Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@inputId" class="mb-2 block text-sm font-medium text-text">@Label</label>
    }

    <div class="relative">
        <input @attributes="AdditionalAttributes"
               id="@inputId"
               type="@(isPassword && revealed ? "text" : Type)"
               value="@Value"
               @onchange="HandleChange"
               placeholder="@Placeholder"
               autocomplete="@AutoComplete"
               required="@Required"
               disabled="@Disabled"
               aria-invalid="@(hasError ? "true" : null)"
               aria-describedby="@describedBy"
               class="@InputClasses(hasError, isPassword)" />

        @if (isPassword)
        {
            <button type="button"
                    @onclick="ToggleReveal"
                    aria-label="@(revealed ? "Hide password" : "Show password")"
                    aria-pressed="@(revealed ? "true" : "false")"
                    class="absolute inset-y-0 right-1 my-auto grid size-10 place-items-center rounded-md text-text-muted transition-colors hover:text-text">
                @if (revealed)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                        <line x1="1" y1="1" x2="23" y2="23" />
                        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                    </svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                }
            </button>
        }
    </div>

    @if (hasError)
    {
        <p id="@errorId" role="alert" class="mt-1.5 text-xs text-error">@ErrorText</p>
    }
    else if (hasHelp)
    {
        <p id="@helpId" class="mt-1.5 text-xs text-text-muted">@HelperText</p>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Label { get; set; }
    /// <summary>text | email | password | ...</summary>
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? AutoComplete { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Extra classes for the outer wrapper.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string autoId = $"input-{Guid.NewGuid():N}";
    private bool revealed;

    private void ToggleReveal() => revealed = !revealed;

    private Task HandleChange(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private static string InputClasses(bool hasError, bool isPassword)
    {
        const string baseClasses =
            "w-full rounded-md border bg-field px-4 py-3 text-sm text-text placeholder:text-text-muted/70 " +
            "transition-colors focus-visible:outline-none focus:ring-3 disabled:cursor-not-allowed disabled:opacity-50";

        var state = hasError
            ? "border-error focus:border-error focus:ring-error/25"
            : "border-border-strong focus:border-gold focus:ring-gold/25";

        return string.Join(' ', new[] { baseClasses, state, isPassword ? "pr-12" : null }
            .Where(c => !string.IsNullOrWhiteSpace(c)));
    }
}
