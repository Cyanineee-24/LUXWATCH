@page "/dev/db-check"
@* TEMPORARY (Phase 2): proves the Supabase client can read. Deleted in Phase 3. No Navbar link. *@
@using LuxWatch.Data.Rows
@using Supabase.Postgrest
@inject Supabase.Client Db

<PageTitle>DB check — LuxWatch</PageTitle>

<Container Class="py-12">
    <h1 class="mb-6 font-display text-2xl font-bold text-text">Supabase connection check</h1>

    @if (loading)
    {
        <p class="text-text-muted">Querying <code>brands</code>…</p>
    }
    else if (error is not null)
    {
        <div class="rounded-md border border-red-500/50 bg-red-500/10 p-4">
            <p class="mb-2 font-semibold text-red-400">Connection failed ✗</p>
            <pre class="whitespace-pre-wrap break-all text-sm text-text">@error</pre>
        </div>
    }
    else
    {
        <p class="mb-1 font-semibold text-gold">Connected ✓</p>
        <p class="mb-4 text-sm text-text-muted">@brands.Count brands returned (expected 20)</p>
        <ol class="list-decimal space-y-1 pl-6 text-text">
            @foreach (var b in brands)
            {
                <li>@b.Name <span class="text-xs text-text-muted">(@b.Slug)</span></li>
            }
        </ol>
    }
</Container>

@code {
    private bool loading = true;
    private string? error;
    private List<BrandRow> brands = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // One request, sorted and limited in the database.
            var res = await Db.From<BrandRow>()
                .Order(b => b.DisplayOrder, Constants.Ordering.Ascending)
                .Range(0, 49)
                .Get();
            brands = res.Models;
        }
        catch (Exception ex)
        {
            error = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
