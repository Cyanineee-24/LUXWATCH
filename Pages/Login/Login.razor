@page "/account/login"

<PageTitle>Login — LuxWatch</PageTitle>

<section class="flex min-h-[calc(100vh-4rem)] flex-col md:flex-row" aria-label="Login">

    <!-- LEFT: hero -->
    <div class="relative flex flex-col overflow-hidden bg-[url('/images/login_hero_art.jpg')] bg-cover bg-center md:w-1/2 lg:w-[58%]">
        <div class="absolute inset-0 bg-linear-to-r from-bg/70 via-bg/55 to-bg/20" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-linear-to-b from-bg/60 via-transparent to-bg/75" aria-hidden="true"></div>

        <div class="relative z-10 flex flex-1 flex-col justify-center px-6 py-16 md:px-12">
            <p class="mb-4 text-sm font-light uppercase tracking-wider text-gold">The Million Dollar Men's Choice</p>
            <h1 class="font-display text-4xl font-bold leading-tight tracking-wide text-text lg:text-5xl">
                A Heritage of<br />Excellence, Secured.
            </h1>
        </div>
        <p class="relative z-10 max-w-lg px-6 pb-10 text-sm font-light leading-relaxed text-text-secondary md:px-12">
            Access your global vault. Track your investments, verify serial profiles,
            and coordinate transfers with luxury boutiques worldwide.
        </p>
    </div>

    <!-- RIGHT: form panel -->
    <div class="flex items-center justify-center bg-panel px-6 py-12 md:w-1/2 md:px-12 lg:w-[42%]">
        <div class="w-full max-w-md">

            <h2 class="font-display text-3xl font-bold tracking-wide text-text">Login</h2>
            <p class="mt-2 text-sm font-light text-text-muted">Enter your credentials to manage your portfolio</p>

            <form @onsubmit="HandleLogin" @onsubmit:preventDefault class="mt-8 space-y-5" novalidate>

                <Input Id="login-email" Label="Email Address" Type="email"
                       Placeholder="marcus.vance@horology.com" AutoComplete="email" Required="true"
                       @bind-Value="Email" />

                <Input Id="login-password" Label="Security Password" Type="password"
                       Placeholder="supersecretpassword" AutoComplete="current-password" Required="true"
                       @bind-Value="Password" />

                <div class="flex items-center justify-between gap-4">
                    <label class="flex cursor-pointer select-none items-center gap-2.5 text-sm text-text-secondary" for="remember-me">
                        <input id="remember-me" type="checkbox" class="peer sr-only" @bind="RememberMe" />
                        <span class="grid size-4 shrink-0 place-items-center rounded-sm border border-border-strong bg-field transition-colors after:mb-0.5 after:h-2 after:w-1 after:rotate-45 after:border-b-2 after:border-r-2 after:border-on-gold after:opacity-0 peer-checked:border-gold peer-checked:bg-gold peer-checked:after:opacity-100 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold"></span>
                        Keep me authenticated
                    </label>
                    <a href="/account/forgot-password" class="whitespace-nowrap text-sm font-medium text-gold hover:text-gold-light hover:underline">Forgot Password?</a>
                </div>

                <Button Type="submit" Size="ButtonSize.Lg" Class="w-full" id="btn-login-submit">Sign In Securely</Button>
            </form>

            <p class="my-6 text-center text-sm text-text-muted">
                New to LUXWATCH?
                <!-- HOOK: Route to future Register page (Pages/Register/Register.razor) using register_hero_art.jpg -->
                <a href="/account/register" class="font-semibold text-gold hover:text-gold-light hover:underline">Register Account</a>
            </p>

            <hr class="mb-6 border-border" />

            <p class="text-xs font-light leading-relaxed text-text-muted">
                By signing in, you agree to our multi-factor identity protocols
                and terms of transaction verification.
            </p>
        </div>
    </div>

</section>

@code {
    /* ---- Form state ---- */
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool RememberMe { get; set; } = false;

    private void HandleLogin()
    {
        // TODO: Wire up authentication logic
        // For now, this is a stub for the form submission handler.
        Console.WriteLine($"Login attempt: {Email}");
    }
}
