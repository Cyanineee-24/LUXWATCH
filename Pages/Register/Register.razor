@page "/account/register"

<PageTitle>Register Account — LuxWatch</PageTitle>

<section class="flex min-h-[calc(100vh-4rem)] flex-col md:flex-row" aria-label="Register Account">

    <!-- LEFT: hero -->
    <div class="relative flex flex-col overflow-hidden bg-[url('/images/register_hero_art.jpg')] bg-cover bg-center md:w-1/2 lg:w-[58%]">
        <div class="absolute inset-0 bg-linear-to-r from-bg/70 via-bg/55 to-bg/20" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-linear-to-b from-bg/60 via-transparent to-bg/75" aria-hidden="true"></div>

        <div class="relative z-10 flex flex-1 flex-col justify-center px-6 py-16 md:px-12">
            <p class="mb-4 text-sm font-light uppercase tracking-wider text-gold">The Million Dollar Men's Choice</p>
            <h1 class="font-display text-4xl font-bold leading-tight tracking-wide text-text lg:text-5xl">
                Acquire. Trade.<br />Verify. Preserve.
            </h1>
        </div>
        <p class="relative z-10 max-w-lg px-6 pb-10 text-sm font-light leading-relaxed text-text-secondary md:px-12">
            Join a global network of premier horologists. Register your personal collection on our
            immutable asset ledger to secure instant authentication status across borders.
        </p>
    </div>

    <!-- RIGHT: form panel -->
    <div class="flex items-center justify-center bg-panel px-6 py-10 md:w-1/2 md:px-12 lg:w-[42%]">
        <div class="w-full max-w-md">

            <h2 class="font-display text-3xl font-bold tracking-wide text-text">Register Account</h2>
            <p class="mt-2 text-sm font-light text-text-muted">Create your collector credential profiles</p>

            <form @onsubmit="HandleRegister" @onsubmit:preventDefault class="mt-6 space-y-4" novalidate>

                <Input Id="register-username" Label="Username" Placeholder="marcusvance"
                       AutoComplete="username" Required="true" @bind-Value="Username" />

                <Input Id="register-fullname" Label="Full Legal Name" Placeholder="Marcus Vance"
                       AutoComplete="name" Required="true" @bind-Value="FullName" />

                <Input Id="register-email" Label="Private Email Address" Type="email"
                       Placeholder="collector@luxwatch.com" AutoComplete="email" Required="true" @bind-Value="Email" />

                <Input Id="register-password" Label="Choose Secure Password" Type="password"
                       Placeholder="Minimum 12 characters" AutoComplete="new-password" Required="true" @bind-Value="Password" />

                <Input Id="register-confirm-password" Label="Confirm Security Password" Type="password"
                       Placeholder="Repeat password" AutoComplete="new-password" Required="true" @bind-Value="ConfirmPassword" />

                <label class="flex cursor-pointer select-none items-start gap-2.5" for="register-consent">
                    <input id="register-consent" type="checkbox" class="peer sr-only" @bind="Consent" />
                    <span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-sm border border-border-strong bg-field transition-colors after:mb-0.5 after:h-2 after:w-1 after:rotate-45 after:border-b-2 after:border-r-2 after:border-on-gold after:opacity-0 peer-checked:border-gold peer-checked:bg-gold peer-checked:after:opacity-100 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold"></span>
                    <span class="text-xs leading-relaxed text-text-muted">
                        I consent to identity validation and agree to the secure trading protocols of LUXWATCH.
                    </span>
                </label>

                <Button Type="submit" Size="ButtonSize.Lg" Class="w-full" id="btn-register-submit">Submit Registration</Button>
            </form>

            <p class="my-5 text-center text-sm text-text-muted">
                Already registered?
                <a href="/account/login" class="font-semibold text-gold hover:text-gold-light hover:underline">Click here to Login</a>
            </p>

            <p class="text-xs font-light leading-relaxed text-text-muted">
                LUXWATCH enforces strict privacy protection. Collector credentials and collection
                listings are kept fully confidential and verified off-chain.
            </p>
        </div>
    </div>

</section>

@code {
    /* ---- Form state ---- */
    private string Username { get; set; } = string.Empty;
    private string FullName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool Consent { get; set; } = false;

    private void HandleRegister()
    {
        // TODO: Wire up registration logic
        // For now, this is a stub for the form submission handler.
        Console.WriteLine($"Registration attempt: {Username} ({Email})");
    }
}
