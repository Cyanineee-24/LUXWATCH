@page "/account/register"

<PageTitle>Register Account — LuxWatch</PageTitle>

<!-- Shared Navigation Header -->
<Navbar NavbarMode="portal" />

<!-- ============================================================
     MAIN — Two-column: Hero Left | Register Form Right
     ============================================================ -->
<section class="register-split" aria-label="Register Account">

    <!-- LEFT COLUMN — Hero image with overlay text -->
    <div class="register-hero">
        <div class="register-hero-overlay"></div>
        <div class="register-hero-content">
            <p class="register-eyebrow">The Million Dollar Men's Choice</p>
            <h1 class="register-headline">Acquire. Trade.<br/>Verify. Preserve.</h1>
        </div>
        <p class="register-hero-footer">
            Join a global network of premier horologists. Register your personal collection on our
            immutable asset ledger to secure instant authentication status across borders.
        </p>
    </div>

    <!-- RIGHT COLUMN — Register form panel -->
    <div class="register-panel">
        <div class="register-form-wrapper">

            <h2 class="register-title">Register Account</h2>
            <p class="register-subtitle">Create your collector credential profiles</p>

            <form @onsubmit="HandleRegister" @onsubmit:preventDefault class="register-form" novalidate>

                <!-- Username -->
                <div class="form-group">
                    <label for="register-username" class="form-label">Username</label>
                    <input id="register-username"
                           type="text"
                           class="form-input"
                           placeholder="marcusvance"
                           @bind="Username"
                           autocomplete="username"
                           required />
                </div>

                <!-- Full Legal Name -->
                <div class="form-group">
                    <label for="register-fullname" class="form-label">Full Legal Name</label>
                    <input id="register-fullname"
                           type="text"
                           class="form-input"
                           placeholder="Marcus Vance"
                           @bind="FullName"
                           autocomplete="name"
                           required />
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label for="register-email" class="form-label">Private Email Address</label>
                    <input id="register-email"
                           type="email"
                           class="form-input"
                           placeholder="collector@luxwatch.com"
                           @bind="Email"
                           autocomplete="email"
                           required />
                </div>

                <!-- Create Password -->
                <div class="form-group">
                    <label for="register-password" class="form-label">Choose Secure Password</label>
                    <div class="input-password-wrap">
                        <input id="register-password"
                               type="@(showCreatePassword ? "text" : "password")"
                               class="form-input form-input--password"
                               placeholder="Minimum 12 characters"
                               @bind="Password"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="password-toggle"
                                @onclick="ToggleCreatePassword"
                                aria-label="@(showCreatePassword ? "Hide password" : "Show password")">
                            @if (showCreatePassword)
                            {
                                <!-- Eye-off icon -->
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="23" x2="23" y2="23" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                </svg>
                            }
                            else
                            {
                                <!-- Eye icon -->
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label for="register-confirm-password" class="form-label">Confirm Security Password</label>
                    <div class="input-password-wrap">
                        <input id="register-confirm-password"
                               type="@(showConfirmPassword ? "text" : "password")"
                               class="form-input form-input--password"
                               placeholder="Repeat password"
                               @bind="ConfirmPassword"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="password-toggle"
                                @onclick="ToggleConfirmPassword"
                                aria-label="@(showConfirmPassword ? "Hide password" : "Show password")">
                            @if (showConfirmPassword)
                            {
                                <!-- Eye-off icon -->
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="23" x2="23" y2="23" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                </svg>
                            }
                            else
                            {
                                <!-- Eye icon -->
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- Consent checkbox -->
                <div class="form-consent-row">
                    <label class="checkbox-label" for="register-consent">
                        <input id="register-consent"
                               type="checkbox"
                               class="checkbox-input"
                               @bind="Consent" />
                        <span class="checkbox-visual"></span>
                        <span class="checkbox-text">
                            I consent to identity validation and agree to the secure trading protocols of LUXWATCH.
                        </span>
                    </label>
                </div>

                <!-- Submit button -->
                <button type="submit" class="btn-register" id="btn-register-submit">
                    SUBMIT REGISTRATION
                </button>

            </form>

            <!-- Login link -->
            <p class="login-prompt">
                Already registered?
                <a href="/account/login" class="login-link">Collector Login</a>
            </p>

            <!-- Disclaimer -->
            <p class="form-disclaimer">
                LUXWATCH enforces strict privacy protection. Collector credentials and collection
                listings are kept fully confidential and verified off-chain.
            </p>
        </div>
    </div>

</section>

@code {
    /* ---- Form state ---- */
    private string Username { get; set; } = string.Empty;
    private string FullName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool Consent { get; set; } = false;

    private bool showCreatePassword = false;
    private bool showConfirmPassword = false;

    private void ToggleCreatePassword() => showCreatePassword = !showCreatePassword;
    private void ToggleConfirmPassword() => showConfirmPassword = !showConfirmPassword;

    private void HandleRegister()
    {
        // TODO: Wire up registration logic
        // For now, this is a stub for the form submission handler.
        Console.WriteLine($"Registration attempt: {Username} ({Email})");
    }
}
