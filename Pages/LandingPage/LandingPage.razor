@page "/"

<header class="site-header">
    <div class="logo">LUXWATCH</div>
    <div class="search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <span>Search through verified outlets worldwide</span>
    </div>
    <a class="account-link" href="/account/login">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
        Login or register
    </a>
</header>

<section class="hero">
    <div class="hero-copy">
        <p class="hero-eyebrow">The Million Dollar Men's Choice</p>
        <h1 class="hero-title">Bestsellers,<br />Timeless Classics</h1>
        <a class="btn" href="/collections/bestsellers">Discover Now</a>
    </div>
    <div class="hero-art" aria-hidden="true">
        <svg class="watch watch-back" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="caseBack" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#d8b98a" />
                    <stop offset="100%" stop-color="#a67c4d" />
                </linearGradient>
            </defs>
            <rect x="70" y="10" width="60" height="30" rx="4" fill="url(#caseBack)" />
            <rect x="70" y="160" width="60" height="30" rx="4" fill="url(#caseBack)" />
            <circle cx="100" cy="100" r="70" fill="url(#caseBack)" />
            <circle cx="100" cy="100" r="56" fill="#141414" />
            <circle cx="100" cy="100" r="2.5" fill="#d8b98a" />
            <line x1="100" y1="100" x2="100" y2="62" stroke="#d8b98a" stroke-width="3" stroke-linecap="round" />
            <line x1="100" y1="100" x2="128" y2="112" stroke="#d8b98a" stroke-width="3" stroke-linecap="round" />
        </svg>
        <svg class="watch watch-front" viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="caseFront" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#c79a67" />
                    <stop offset="100%" stop-color="#8a6238" />
                </linearGradient>
            </defs>
            <rect x="60" y="180" width="100" height="34" rx="6" fill="#1a1a1a" />
            <circle cx="110" cy="110" r="80" fill="url(#caseFront)" />
            <circle cx="110" cy="110" r="64" fill="#0f0f0f" />
            <circle cx="110" cy="110" r="2.5" fill="#c79a67" />
            <line x1="110" y1="110" x2="110" y2="66" stroke="#c79a67" stroke-width="3" stroke-linecap="round" />
            <line x1="110" y1="110" x2="142" y2="126" stroke="#c79a67" stroke-width="3" stroke-linecap="round" />
            <circle cx="150" cy="90" r="10" fill="#0f0f0f" stroke="#c79a67" stroke-width="2" />
        </svg>
    </div>
</section>

<section class="stats-section">
    <h2 class="stats-heading">The Leading Marketplace for Luxury Watches Since 2003</h2>
    <div class="stats-grid">

        @foreach (var stat in Stats)
        {
            <div class="stat-card">
                <div class="stat-icon">@((MarkupString)stat.IconSvg)</div>
                <div class="stat-number">@stat.Number</div>
                <div class="stat-desc">@stat.Description</div>
            </div>
        }

    </div>
</section>

@code {
    private record Stat(string Number, string Description, string IconSvg);

    // Pulling these from a list makes it trivial to reorder or bind to a CMS/API later.
    private List<Stat> Stats { get; } = new()
    {
        new Stat("4.7 out of 5 stars", "from 204,000 reviews worldwide",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='9' cy='8' r='3.2'/><path d='M4 20c0-3.3 2.2-5.5 5-5.5s5 2.2 5 5.5'/><path d='M15.5 9.5a2 2 0 1 0 3 1.7'/><path d='M15 4.8s1.6.4 1.6 2'/></svg>"),
        new Stat("9 Million", "watch enthusiasts use Chrono24 each month",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='12' cy='12' r='8'/><path d='M12 8v4l2.5 2.5'/><path d='M9.2 20.2a3 3 0 0 0 5.6 0'/></svg>"),
        new Stat("Over 340,000", "customers choose Buyer Protection annually",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M4 12h6l2-3 2 5 2-3h4'/><circle cx='17' cy='12' r='8'/></svg>"),
        new Stat("More Than 25,000", "trustworthy sellers",
            "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='9' cy='7' r='3'/><path d='M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6'/><path d='M17.5 8.5 19 10l3-3'/></svg>"),
    };
}
