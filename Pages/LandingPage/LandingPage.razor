@page "/"

<PageTitle>LuxWatch — The Million Dollar Men's Choice</PageTitle>

<!-- HERO -->
<section class="relative flex min-h-[420px] items-center overflow-hidden bg-[url('/images/landing_page_hero_art.jpg')] bg-cover bg-center md:h-[56vh] md:max-h-155 md:bg-right"
         aria-label="Featured collection">
    <div class="absolute inset-0 bg-linear-to-r from-bg/95 via-bg/80 to-bg/40 md:from-bg/90 md:via-bg/60 md:to-bg/5" aria-hidden="true"></div>

    <Container Class="relative z-10 py-16">
        <div class="max-w-xl">
            <p class="mb-4 text-sm font-light tracking-wide text-gold">The Million Dollar Men's Choice</p>
            <h1 class="mb-8 font-display text-4xl font-bold leading-tight tracking-wide text-text md:text-5xl">
                Bestsellers,<br />Timeless Classics
            </h1>
            <Button Href="/collections/bestsellers" Variant="ButtonVariant.Secondary" Size="ButtonSize.Lg">Discover Now</Button>
        </div>
    </Container>
</section>

<!-- STATS / TRUST -->
<PageSection Title="The Leading Marketplace for Luxury Watches Since 2003" Centered="true">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Trust and marketplace statistics">
        @foreach (var stat in Stats)
        {
            <li>
                <Card Hoverable="true" Class="h-full text-center">
                    <div class="mx-auto mb-4 size-12 text-icon [&>svg]:size-full" aria-hidden="true">@((MarkupString)stat.IconSvg)</div>
                    <p class="text-xl font-bold italic leading-snug text-text">@stat.Number</p>
                    <p class="mt-2 text-sm text-text-muted">@stat.Description</p>
                </Card>
            </li>
        }
    </ul>
</PageSection>

@code {
    private record Stat(string Number, string Description, string IconSvg);

    // Stat data — trivial to reorder or bind to a CMS/API later.
    private List<Stat> Stats { get; } = new()
    {
        new Stat("4.7 out of 5 stars", "from 204,000 reviews worldwide",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='16' r='6'/><path d='M6 40c0-6.6 5.4-12 12-12s12 6.6 12 12'/><path d='M32 18a5 5 0 1 1 0-10'/><path d='M36 40c0-5-2.8-9.3-7-11.5'/></svg>"),
        new Stat("9 Million", "watch enthusiasts use Chrono24 each month",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='16'/><path d='M24 14v10l7 7'/><path d='M17 42.5c2.1 1 4.5 1.5 7 1.5s4.9-.5 7-1.5'/><path d='M24 42v4'/><circle cx='24' cy='24' r='2'/></svg>"),
        new Stat("Over 340,000", "customers choose Buyer Protection annually",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 28h8l3-6 4 12 3-6h6'/><circle cx='24' cy='24' r='18'/></svg>"),
        new Stat("More Than 25,000", "trustworthy sellers",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='16' r='6'/><path d='M6 40c0-6.6 5.4-12 12-12s12 6.6 12 12'/><path d='M34 16l3 3 6-6'/></svg>"),
    };
}
