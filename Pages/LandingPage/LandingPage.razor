@page "/"

<PageTitle>LuxWatch — The Million Dollar Men's Choice</PageTitle>

<!-- ============================================================
     HEADER
     ============================================================ -->
<header class="site-header" role="banner">
    <a href="/" class="logo" aria-label="LuxWatch Home">Luxwatch</a>

    <div class="search-bar" role="search" aria-label="Search watches">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span>Search through verified outlets worldwide</span>
    </div>

    <a class="account-link" href="/account/login">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
        </svg>
        <span>Login or register</span>
    </a>

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu"
            aria-label="Toggle navigation menu" aria-expanded="@(!mobileMenuCollapsed)">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</header>

<!-- Mobile dropdown menu -->
@if (!mobileMenuCollapsed)
{
    <div class="mobile-menu" role="navigation" aria-label="Mobile navigation">
        <div class="mobile-menu-inner">
            <div class="mobile-search" role="search">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <span>Search through verified outlets worldwide</span>
            </div>
            <a class="mobile-account-link" href="/account/login">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                </svg>
                Login or register
            </a>
        </div>
    </div>
}

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="hero" aria-label="Featured collection">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <p class="hero-eyebrow">The Million Dollar Men's Choice</p>
        <h1 class="hero-title">Bestsellers,<br />Timeless Classics</h1>
        <a class="btn-primary" href="/collections/bestsellers">Discover Now</a>
    </div>
</section>

<!-- ============================================================
     STATS / TRUST SECTION
     ============================================================ -->
<section class="stats-section" aria-label="Trust and marketplace statistics">
    <h2 class="stats-heading">The Leading Marketplace for Luxury Watches Since 2003</h2>
    <div class="stats-grid">
        @foreach (var stat in Stats)
        {
            <div class="stat-card">
                <div class="stat-icon" aria-hidden="true">@((MarkupString)stat.IconSvg)</div>
                <div class="stat-number">@stat.Number</div>
                <div class="stat-desc">@stat.Description</div>
            </div>
        }
    </div>
</section>

@code {
    private bool mobileMenuCollapsed = true;

    private void ToggleMobileMenu()
    {
        mobileMenuCollapsed = !mobileMenuCollapsed;
    }

    private record Stat(string Number, string Description, string IconSvg);

    // Stat data — trivial to reorder or bind to a CMS/API later.
    private List<Stat> Stats { get; } = new()
    {
        new Stat("4.7 out of 5 stars", "from 204,000 reviews worldwide",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='16' r='6'/><path d='M6 40c0-6.6 5.4-12 12-12s12 6.6 12 12'/><path d='M32 18a5 5 0 1 1 0-10'/><path d='M36 40c0-5-2.8-9.3-7-11.5'/></svg>"),
        new Stat("9 Million", "watch enthusiasts use Chrono24 each month",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='24' cy='24' r='16'/><path d='M24 14v10l7 7'/><path d='M17 42.5c2.1 1 4.5 1.5 7 1.5s4.9-.5 7-1.5'/><path d='M24 42v4'/><circle cx='24' cy='24' r='2'/></svg>"),
        new Stat("Over 340,000", "customers choose Buyer Protection annually",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 28h8l3-6 4 12 3-6h6'/><circle cx='24' cy='24' r='18'/></svg>"),
        new Stat("More Than 25,000", "trustworthy sellers",
            "<svg viewBox='0 0 48 48' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='16' r='6'/><path d='M6 40c0-6.6 5.4-12 12-12s12 6.6 12 12'/><path d='M34 16l3 3 6-6'/></svg>"),
    };
}
